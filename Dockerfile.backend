# Backend Dockerfile - Local AI Research Lab
# Python-based FastAPI backend with ML dependencies

FROM python:3.11-slim as base

# Metadata
LABEL maintainer="Kenan AY"
LABEL author="Kenan AY"
LABEL description="FastAPI backend for AI Research Lab"
LABEL version="1.2.0"

# Çalışma dizini
WORKDIR /app

# Sistem dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies için cache layer
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Uygulama kodunu kopyala
COPY src/ ./src/
COPY backend/ ./backend/
COPY configs/ ./configs/

# Data dizinlerini oluştur
RUN mkdir -p \
    datasets/raw \
    datasets/processed \
    datasets/canonical \
    models/registry \
    models/checkpoints \
    logs \
    uploads

# Environment variables
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV LOG_LEVEL=INFO

# Port expose
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Uvicorn ile başlat
CMD ["python", "-m", "uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
