# Backend Configuration
BACKEND_HOST=localhost
BACKEND_PORT=8000
BACKEND_RELOAD=true
BACKEND_WORKERS=1

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Local AI Research Lab"

# Database
DATABASE_URL=sqlite:///./local_ai_lab.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_lab

# Security
SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=true

# Data Paths
DATA_ROOT=./datasets
RAW_DATA_PATH=./datasets/raw
PROCESSED_DATA_PATH=./datasets/normalized
MODEL_PATH=./models
CHECKPOINT_PATH=./checkpoints
TOKENIZER_PATH=./tokenizers
EXPERIMENT_PATH=./experiments

# GPU Configuration
CUDA_VISIBLE_DEVICES=0
# CUDA_VISIBLE_DEVICES=0,1,2,3  # Multi-GPU

# Training Configuration
DEFAULT_BATCH_SIZE=16
DEFAULT_LEARNING_RATE=0.0003
DEFAULT_MAX_EPOCHS=10

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
CONTENT_CLEANUP_INTERVAL_SECONDS=300

# Feature Flags
ENABLE_MULTIMODAL=false
ENABLE_DISTRIBUTED=false
ENABLE_RAG=true
RAG_EMBEDDER_TYPE=local
RAG_MODEL_NAME=all-MiniLM-L6-v2
RAG_ALLOW_DUMMY_FALLBACK=false

# External Services (Opsiyonel)
# REDIS_URL=redis://localhost:6379
# VECTOR_DB_URL=http://localhost:6333  # Qdrant

# Security & Privacy
PII_DETECTION_ENABLED=true
AUTO_TRAINING_ALLOWED=false
DATA_RETENTION_DAYS=365

# Development
ENVIRONMENT=development
SEED_DEMO_USERS=true
DEBUG=true
ENABLE_CORS=true
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000","http://127.0.0.1:3001","http://localhost:8000","http://127.0.0.1:8000"]
